# Diff Review Tiers: example environment. Copy to .env only for a Roy-approved Normal-mode run.
# Arm A needs no environment at all. No paid call is made by default.

# Live reviewer dispatch (arm B) is off. 0 = every live dispatch is refused.
S45_LIVE=0

# Spend cap in USD. With cap 0 every live dispatch is refused before it is sent (plan 8.8).
S45_BUDGET_USD=0

# A live dispatch additionally requires a recorded Roy approval id. Empty = no approval.
S45_ROY_APPROVAL_ID=

# Provider key NAMES only. No live adapter exists in this repo; never put real values in any committed file.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
