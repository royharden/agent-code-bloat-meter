{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s45:schema:receipt:1",
  "title": "WitnessReceiptV1",
  "description": "plan 7.4 / D17: one witness or base-sanity test execution recorded by the corpus author's harness. sha256 is computed over the receipt without the sha256 field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "changeId",
    "side",
    "command",
    "exitCode",
    "outcome",
    "sourceHash",
    "testHash",
    "harnessVersion",
    "recordedAt",
    "sha256"
  ],
  "properties": {
    "schema": { "const": "s45.receipt/1" },
    "changeId": { "type": "string", "minLength": 1 },
    "side": { "enum": ["base", "head"] },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exitCode": { "type": "integer" },
    "outcome": { "enum": ["pass", "assertion_fail", "other_fail", "timeout"] },
    "failedTest": { "type": "string", "minLength": 1 },
    "expected": { "type": "string" },
    "actual": { "type": "string" },
    "sourceHash": { "$ref": "#/$defs/sha256" },
    "testHash": { "$ref": "#/$defs/sha256" },
    "harnessVersion": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "assertion_fail" } }, "required": ["outcome"] },
      "then": { "required": ["failedTest"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
