{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s45:schema:label:1",
  "title": "LabelV1",
  "description": "plan 7.4: scorer-only label for one change. Analysis code never reads labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "changeId", "rootId", "split", "kind", "baseSanityReceipts"],
  "properties": {
    "schema": { "const": "s45.label/1" },
    "changeId": { "type": "string", "minLength": 1 },
    "rootId": { "type": "string", "minLength": 1 },
    "split": { "$ref": "#/$defs/split" },
    "kind": { "enum": ["clean", "defect", "near_miss"] },
    "trapIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^N[1-8]$" }
    },
    "defect": { "$ref": "#/$defs/defect" },
    "cleanWitnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "headPassHash"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "headPassHash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "baseSanityReceipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "basePassHash"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "basePassHash": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "defect" } }, "required": ["kind"] },
      "then": { "required": ["defect"], "not": { "required": ["cleanWitnesses"] } },
      "else": { "required": ["cleanWitnesses"], "not": { "required": ["defect"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "near_miss" } }, "required": ["kind"] },
      "then": { "required": ["trapIds"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "split": { "enum": ["dev", "heldout"] },
    "family": {
      "enum": [
        "boundary",
        "null_optional",
        "await_ordering",
        "authz_weakened",
        "validation_escaping",
        "error_swallowed_mismapped",
        "state_cache_lifecycle",
        "logic_value"
      ]
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "side", "line"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "side": { "enum": ["base", "head"] },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "operator",
        "siteId",
        "requiredAtoms",
        "anchorKind",
        "signatureBearing",
        "cleanTwinId",
        "witnessTest",
        "cleanHeadPassHash",
        "headAssertionFailureHash"
      ],
      "properties": {
        "family": { "$ref": "#/$defs/family" },
        "operator": { "type": "string", "minLength": 1 },
        "siteId": { "type": "string", "minLength": 1 },
        "requiredAtoms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/atom" } },
        "anchorKind": { "enum": ["edited", "r-del-gap", "base-deletion"] },
        "signatureBearing": { "type": "boolean" },
        "cleanTwinId": { "type": "string", "minLength": 1 },
        "witnessTest": { "type": "string", "minLength": 1 },
        "cleanHeadPassHash": { "$ref": "#/$defs/sha256" },
        "headAssertionFailureHash": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "anchorKind": { "const": "r-del-gap" } }, "required": ["anchorKind"] },
          "then": {
            "properties": {
              "requiredAtoms": { "maxItems": 2, "items": { "properties": { "side": { "const": "head" } } } }
            }
          }
        },
        {
          "if": { "properties": { "anchorKind": { "const": "base-deletion" } }, "required": ["anchorKind"] },
          "then": {
            "properties": { "requiredAtoms": { "items": { "properties": { "side": { "const": "base" } } } } }
          }
        },
        {
          "if": { "properties": { "anchorKind": { "const": "edited" } }, "required": ["anchorKind"] },
          "then": {
            "properties": { "requiredAtoms": { "items": { "properties": { "side": { "const": "head" } } } } }
          }
        }
      ]
    }
  }
}
